      "resourceTypes": ["sub_frame", "script", "image", "xmlhttprequest", "ping"]
    },
    {
      "pattern": "||taboola.com^",
      "action": "block",
      "category": "advertising",
      "resourceTypes": ["sub_frame", "script", "image", "xmlhttprequest"]
    },
    {
      "pattern": "||outbrain.com^",
      "action": "block",
